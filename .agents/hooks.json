{
  "codex-pet-sync": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/pet_hook.py pre_invocation"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pet_hook.py pre_tool_use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pet_hook.py post_tool_use"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/pet_hook.py stop"
      }
    ]
  }
}
